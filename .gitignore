# ──────────────────────────────
# Node & Package Management
# ──────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────────────────────
# Environment & Local Config
# ──────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────
# Runtime & Data Files
# ──────────────────────────────
data/logs/*
!data/logs/.gitkeep

data/notes/*
!data/notes/.gitkeep

data/keyhappenings.json

# ──────────────────────────────
# System / Editor / OS
# ──────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.tmp
*.bak

# ──────────────────────────────
# Build Artifacts / Generated Docs
# ──────────────────────────────
*.log
*.pid
docs/**/*.pdf
docs/**/*.docx
docs/**/*.zip
dist/
build/
coverage/

# ──────────────────────────────
# Test / Playground
# ──────────────────────────────
test.js
playground/
sandbox/
scratch.*

# ──────────────────────────────
# Miscellaneous Safety Nets
# ──────────────────────────────
# Exclude any local JSONs generated at runtime
data/*.json
!data/.keep
