# Discord
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=123456789012345678
# Comma-separated channel IDs that the bot is allowed to read/summarize
DISCORD_ALLOWED_CHANNEL_IDS=111111111111111111,222222222222222222
# Where to post daily summaries (can be one of the allowed channels)
DISCORD_SUMMARY_CHANNEL_ID=333333333333333333
# (Optional) A channel to create a permanent server invite from on startup
DISCORD_INVITE_CHANNEL_ID=
# (Optional) Permissions integer for the bot OAuth invite URL printed on startup
# ViewChannel (1024) + SendMessages (2048) + ReadMessageHistory (65536) + EmbedLinks (16384) = 84992
INVITE_PERMISSIONS=84992

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Scheduling
TIMEZONE=Asia/Dhaka
DAILY_SUMMARY_CRON=0 21 * * *     # 21:00 local time by default

# Storage
DATA_DIR=./data

# Behavior flags
REDACT_PII=true
OPT_OUT_KEYWORD=#noai
MAX_CONTEXT_MESSAGES=500
SUMMARY_HOURS_DEFAULT=24

STATUS_PORT=3000
