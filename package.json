{
	"name": "purrfect-discord-bridge",
	"version": "1.0.0",
	"type": "module",
	"main": "dist/index.js",
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format": "biome format .",
		"register-commands": "tsx src/commands.ts",
		"test": "tsx --test tests/**/*.test.ts"
	},
	"dependencies": {
		"cron": "^3.1.7",
		"discord.js": "^14.15.3",
		"dotenv": "^16.4.5",
		"luxon": "^3.5.0",
		"openai": "^4.56.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.0",
		"@types/node": "^22.10.1",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3"
	}
}
